# Copy to .env; never commit real keys.
TAVILY_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Qwen: use your compatible endpoint and available model name.
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# Default settings use api:text-embedding-v4. For DeepSeek chat, supply a separate
# embedding endpoint/key, or explicitly select a local model in settings.yaml.
# Empty embedding variables reuse LLM_BASE_URL and LLM_API_KEY (works with Qwen).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
